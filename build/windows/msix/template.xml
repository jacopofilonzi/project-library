<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="project-library.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Jacopo Filonzi\Project Library">
    </Installer>
    <PackageInformation
        PackageName="Project Library"
        PackageDisplayName="Project Library"
        PublisherName="CN=Jacopo Filonzi"
        PublisherDisplayName="Jacopo Filonzi"
        Version="0.1.4.0"
        PackageDescription="A project-library application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.projectlibrary"
                Description="A project-library application"
                DisplayName="Project Library"
                ExecutableName="project-library.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Project Library</DisplayName>
            <PublisherDisplayName>Jacopo Filonzi</PublisherDisplayName>
            <Description>A project-library application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="project-library.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
